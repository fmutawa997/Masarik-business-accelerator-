# Copy to .env.local and fill in from your Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only secrets live in Supabase Edge Function secrets, NOT here:
#   MYFATOORAH_API_KEY, MYFATOORAH_BASE_URL  (set via: supabase secrets set ...)
